[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "pressfreedom"]
	path = pressfreedom
	url = https://github.com/petzi53/pressfreedom
[submodule "pressfreedom.data"]
	path = pressfreedom.data
	url = https://github.com/petzi53/pressfreedom.data
[submodule "qpost"]
	path = qpost
	url = https://github.com/petzi53/qpost
[submodule "repairData"]
	path = repairData
	url = https://github.com/petzi53/repairdata
